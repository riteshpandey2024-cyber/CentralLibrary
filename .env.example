# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Secret key used to sign session tokens (auto-generated fallback used in dev if omitted).
AUTH_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ADMIN_BOOTSTRAP_EMAIL & ADMIN_BOOTSTRAP_PASSWORD: Optional initial administrator credentials.
# If omitted, the first admin account can be initialized once via the secure /admin-setup page.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Required for live Razorpay order creation and signature verification.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# DATA_DIR: Directory for persistent database JSON storage (defaults to ./data).
DATA_DIR="./data"
